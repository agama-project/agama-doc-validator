{
  "name": "agama-doc-validator",
  "private": true,
  "version": "1.0.1",
  "description": "Validator for Agama JSON profiles included in the official SUSE documentation",
  "bin": {
    "agama-doc-validator": "./src/agama-doc-validator.ts"
  },
  "type": "module",
  "scripts": {
    "start": "tsx src/agama-doc-validator.ts",
    "test": "tsx --test tests/*.test.ts",
    "eslint": "npx eslint .",
    "eslint:fix": "npx eslint --fix .",
    "package": "rm -rf ./dist && npx ncc build -m src/action.ts -o dist",
    "bundle": "rm -rf ./bundle && npx ncc build -m src/agama-doc-validator.ts -o bundle && mv bundle/index.js bundle/agama-doc-validator.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "markdownlint": "npx markdownlint-cli2 '**/*.md' '#node_modules'",
    "all": "npm run format:check && npm run eslint && npm run markdownlint && npm run package"
  },
  "dependencies": {
    "@apideck/better-ajv-errors": "^0.3.7",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@eslint/compat": "^2.0.2",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/sax": "^1.2.7",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
